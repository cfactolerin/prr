{
  "name": "opencode-prr",
  "version": "0.27.0",
  "description": "OpenCode plugin for independent OpenCode and Codex pull request reviews",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./tui": "./tui.js"
  },
  "files": [
    ".opencode/agents",
    ".opencode/commands",
    ".opencode/skills",
    "bin/prr-darwin-universal",
    "index.js",
    "atlassian.js",
    "review-state.js",
    "review-rpc.js",
    "review-diff.js",
    "review-reader.js",
    "review-panel.js",
    "tui.js",
    "README.md"
  ],
  "os": [
    "darwin"
  ],
  "cpu": [
    "arm64",
    "x64"
  ],
  "scripts": {
    "test": "node --test tests/*.test.js"
  },
  "keywords": [
    "opencode",
    "plugin",
    "pull-request",
    "code-review",
    "codex"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cfactolerin/prr.git"
  },
  "bugs": {
    "url": "https://github.com/cfactolerin/prr/issues"
  },
  "homepage": "https://github.com/cfactolerin/prr#readme",
  "author": "Cris Factolerin",
  "license": "UNLICENSED",
  "dependencies": {
    "@opencode-ai/plugin": "^1.18.31",
    "@opencode/plugin": "^2.1.0",
    "yaml": "^2.8.1"
  },
  "devDependencies": {
    "@opentui/core": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "solid-js": "^1.9.17"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.6.6",
    "@opentui/solid": ">=0.6.6",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  },
  "overrides": {
    "@opentui/solid": {
      "solid-js": "$solid-js"
    }
  }
}
